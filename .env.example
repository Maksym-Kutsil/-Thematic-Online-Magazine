# --- PostgreSQL (docker-compose + Nest API share these) ---
POSTGRES_DB=thematic_magazine
POSTGRES_USER=magazine_user
POSTGRES_PASSWORD=magazine_pass
POSTGRES_PORT=5432

# --- Nest API ---
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=thematic_magazine
DB_USER=magazine_user
DB_PASSWORD=magazine_pass

JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=1d

# --- Next.js web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
